# Postgres (Neon pooled connection string in production)
DATABASE_URL=postgres://postgres:dev@localhost:54329/dirabot

# Gmail SMTP via an App Password (Google Account → Security → App passwords)
SMTP_USER=you@gmail.com
SMTP_PASS=
NOTIFY_TO=you@gmail.com

# Public dashboard URL, used for links in the email (also needed on Vercel for subscriber sign-up)
DASHBOARD_URL=https://your-project.vercel.app
# Without SMTP, set MAIL_LOG=1 to print emails instead of sending them (the dev server does this automatically)
# MAIL_LOG=1

# Apify (Madlan + Facebook). Leave empty to skip those sources.
APIFY_TOKEN=
# Comma-separated public Facebook group URLs
FB_GROUP_URLS=

# Optional passcode for adding/removing cities from the dashboard
ADMIN_PASSCODE=

# Scraper tuning
YAD2_MAX_PAGES=2

# Web Push: same keys in Vercel env and GitHub Actions secrets. Generate ONCE:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI, e.g. mailto:you@gmail.com (must be a real contact; avoid localhost for Safari)
VAPID_SUBJECT=mailto:you@gmail.com

# Weekly Google discovery of developer projects (free SerpApi account).
# Set in GitHub Actions secrets; Vercel does not call Google during page views.
SERPAPI_API_KEY=
# Optional explicit project pages on supported official developer domains
PROJECT_URLS=
PROJECT_MAX_PAGES=150
# Run the daily projects collector outside the 00:00 UTC slot when testing
# FORCE_PROJECTS=1

# Public OSM/Photon address lookup is cached, capped at 15 new addresses/run.
# Optional alternate Photon endpoint (no geocoding during page views)
PROJECT_GEOCODER_URL=https://photon.komoot.io/api/
